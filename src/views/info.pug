doctype html
html(lang="hr")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Propusnica
    link(rel="stylesheet" href="/style.css")
  body.page-info
    if !pass
      h1 Propusnica ne postoji
    else
      h1 Propusnica
      p.status(class=pass.status)= pass.status
      p #[strong Ime i prezime:] #{pass.name}
      p #[strong Dokument:] #{pass.document}
      p #[strong Izdano:] #{new Date(pass.issued_at).toISOString()}